# Local only (gitignored as .env.r2). A bucket-scoped R2 API token with Object Read & Write.
# Never add these to Vercel: the site only needs NEXT_PUBLIC_PHOTO_CDN_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=jpvalery-photos
R2_ORIGINALS_BUCKET=jpvalery-originals
# Where the original photo files live (default ~/Pictures/jpvalery-library)
# PHOTOS_SRC=
