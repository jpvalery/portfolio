{
	"name": "jpvalery-photo",
	"version": "4.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.27.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "node scripts/check/guards.ts --src && next build && node scripts/check/guards.ts --out",
		"check": "biome check . && tsc --noEmit && node scripts/check/content.ts && pnpm test",
		"test": "node --test tests/*.test.ts",
		"lint": "biome check .",
		"format": "biome check --write .",
		"photos:ingest": "node --env-file-if-exists=.env.r2 scripts/photos/ingest.ts",
		"photos:verify": "node scripts/photos/verify.ts",
		"photos:backup": "node --env-file-if-exists=.env.r2 scripts/photos/backup.ts",
		"import:archive": "node scripts/import/archive.ts",
		"import:contentful": "node --env-file=.migration/contentful.env scripts/import/contentful-fetch.ts && node scripts/import/contentful-build.ts",
		"gen:vercel": "node scripts/gen/vercel-json.ts",
		"check:budget": "node scripts/check/budget.ts",
		"check:smoke": "node scripts/check/smoke.ts",
		"gen:press": "node scripts/gen/press-logos.ts"
	},
	"dependencies": {
		"js-yaml": "5.4.3",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1147.0",
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/typography": "0.5.20",
		"@types/hast": "3.0.5",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"exifr": "7.1.3",
		"logo-soup": "0.2.3",
		"playwright-core": "1.63.0",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	}
}
